{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "types": ["node"],
    // "rootDir": "src",
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"],
      "@modules/*": ["./modules/*"],
      "@config/*": ["./modules/config/*"],
      "@auth/*": ["./modules/auth/*"],
      "@root/shared": ["../../../libs/shared/src/index.ts"],
      "@root/shared/*": ["../../../libs/shared/src/*"],
      "@generated/prisma": ["../../../generated/prisma"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
